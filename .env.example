# Google Gemini API Key (Google AI Studio; default STT & LLM provider)
GEMINI_API_KEY=

# ElevenLabs API Key (optional; for Scribe v3/v2 speech-to-text)
# Tip: You can also run `npx -y @elevenlabs/cli@latest onboard init` locally to obtain a key.
ELEVENLABS_API_KEY=

# OpenAI API Key (optional; for gpt-6.2-sol / gpt-6-luna translation or Whisper STT)
OPENAI_API_KEY=

# Generic OpenAI-compatible gateway API Key (optional; DeepSeek / OpenRouter / Groq / Ollama etc.)
# OPENAI_COMPAT_API_KEY=

# Optional HTTP/HTTPS proxy (note: ElevenLabs Free tier may reject shared VPN IPs)
# HTTPS_PROXY=http://127.0.0.1:7890
